# Claude API Configuration
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Vrew Configuration
# Vrew CLIのパス（オプション - CLIがある場合のみ）
VREW_CLI_PATH=/path/to/vrew/cli

# Vrew監視フォルダ（Vrewが自動的にインポートするフォルダ）
VREW_WATCH_FOLDER=./output/vrew_projects

# 動画出力フォルダ
VREW_OUTPUT_FOLDER=./output/videos

# Topic Selector Configuration
# トピック設定ファイルのパス
TOPICS_CONFIG_PATH=./config/topics.yaml

# Logging Configuration
LOG_LEVEL=INFO
